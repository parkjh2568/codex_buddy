{
  "name": "onggi-bot",
  "productName": "OnggiBot",
  "version": "0.1.0-alpha.22",
  "description": "A modular desktop companion connected to your local Codex CLI",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "demo": "npm run build && electron . --demo",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "smoke": "npm run build && electron . --smoke",
    "smoke:real": "npm run build && electron . --real-smoke",
    "smoke:models": "npm run build && electron . --model-smoke",
    "characters:generate": "node scripts/create-characters.cjs",
    "icons:generate": "electron scripts/create-icons.cjs",
    "icons:icns": "node scripts/icns.cjs",
    "codex:smoke": "node scripts/codex-smoke.cjs",
    "package": "npm run build && node scripts/package.cjs",
    "smoke:history": "npm run build && electron . --history-smoke",
    "smoke:pointer": "npm run build && electron . --pet-pointer-smoke",
    "smoke:floating": "npm run build && electron . --floating-smoke",
    "smoke:timing": "npm run build && electron . --timing-smoke",
    "smoke:performance": "npm run build && electron . --performance-smoke",
    "smoke:delete": "npm run build && electron . --delete-smoke",
    "codex:delete-smoke": "node scripts/codex-delete-smoke.cjs",
    "smoke:buddy": "npm run build && electron . --buddy-features-smoke",
    "codex:personas": "node scripts/persona-real-smoke.cjs",
    "lint": "eslint src scripts test *.config.cjs && node scripts/lint-css.cjs",
    "smoke:stability": "npm run build && electron . --stability-smoke",
    "smoke:resources": "npm run build && electron . --resource-smoke",
    "smoke:lifecycle": "npm run build && electron . --buddy-lifecycle-smoke",
    "smoke:assets": "electron scripts/asset-validation-smoke.cjs",
    "smoke:connection-images": "npm run build && electron . --connection-image-smoke",
    "smoke:attachments": "npm run build && electron . --attachments-smoke",
    "smoke:integration": "npm run build && node scripts/integration-smoke.cjs",
    "smoke:chat-ui": "npm run build && node scripts/integration-smoke.cjs chat-ui",
    "verify:package": "electron scripts/verify-package.cjs",
    "smoke:packaged-resources": "electron scripts/packaged-resource-smoke.cjs",
    "codex:attachments": "electron scripts/real-input-smoke.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "css-tree": "3.2.1",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "markdown-it": "15.0.2",
    "markdown-it-cjk-friendly": "3.0.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
